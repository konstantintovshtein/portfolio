{
  "name": "konstantin-tovshtein-portfolio",
  "version": "1.0.0",
  "description": "Personal portfolio of Konstantin Tovshtein, based on the Dopefolio template.",
  "main": "index.js",
  "scripts": {
    "build:html": "python tools/build_pages.py",
    "compile:scss": "sass sass/main.scss css/style.css --no-source-map --silence-deprecation=import",
    "watch:scss": "sass sass/main.scss css/style.css --no-source-map --silence-deprecation=import --watch",
    "prefix:css": "postcss css/style.css --use autoprefixer -o css/style.css --no-map",
    "compress:css": "sass css/style.css css/style.css --style=compressed --no-source-map --silence-deprecation=import",
    "build": "npm-run-all compile:scss prefix:css compress:css"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "author": "Konstantin Tovshtein",
  "license": "GPL-3.0",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0"
  }
}
